# --- API (FastAPI) ---
RAG_DATABASE_URL=postgresql://rag:rag@localhost:5432/rag
# Optional: enables the answer-generation + LLM-as-judge tracks. Without it,
# ingestion, retrieval, and retrieval-metric evals still work fully.
RAG_ANTHROPIC_API_KEY=

