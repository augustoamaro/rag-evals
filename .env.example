# --- API (FastAPI) ---
RAG_DATABASE_URL=postgresql://rag:rag@localhost:5432/rag
# Optional: enables the answer-generation + LLM-as-judge tracks. Without it,
# ingestion, retrieval, and retrieval-metric evals still work fully.
RAG_ANTHROPIC_API_KEY=
# Optional dataset YAML / extracted BEIR directory (default: corpus/benchmark.yaml).
# RAG_DATASET_PATH=/absolute/path/to/benchmark.yaml
# Pin a historical index and its stored dataset; otherwise resolve current inputs.
# RAG_INDEX_ID=idx_<sha256>
RAG_CHUNK_TARGET_WORDS=180
RAG_CHUNK_OVERLAP_WORDS=30

# --- Dashboard (Next.js) ---
# The API URL as reachable FROM THE BROWSER (baked at build time).
NEXT_PUBLIC_API_URL=http://localhost:8000
