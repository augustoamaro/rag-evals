# syntax=docker/dockerfile:1
FROM python:3.12-slim AS runtime

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy

RUN pip install --no-cache-dir "uv>=0.5"

WORKDIR /app

# Install dependencies first for better layer caching.
COPY pyproject.toml uv.lock ./
COPY src ./src
RUN uv sync --frozen --no-dev

# Bake the embedding model into the image so the first run needs no network.
RUN uv run python -c \
    "from fastembed import TextEmbedding; TextEmbedding('BAAI/bge-small-en-v1.5')"

COPY migrations ./migrations
COPY corpus ./corpus

ENV RAG_DATABASE_URL=postgresql://rag:rag@db:5432/rag
EXPOSE 8000

# Apply migrations + ingest the corpus, then serve the API.
CMD ["sh", "-c", "uv run rag ingest && uv run uvicorn rag.api.app:build_app --factory --host 0.0.0.0 --port 8000"]
