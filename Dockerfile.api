# syntax=docker/dockerfile:1
FROM python:3.12-slim AS runtime

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy

RUN pip install --no-cache-dir "uv>=0.5"

WORKDIR /app

# 1. Dependencies only — this layer (and the model bakes below) survives source
#    edits because src/ is copied later.
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project

# 2. Bake the local models so the first run needs no network.
RUN uv run --no-sync python -c \
    "from fastembed import TextEmbedding; TextEmbedding('BAAI/bge-small-en-v1.5')"
RUN uv run --no-sync python -c \
    "from fastembed.rerank.cross_encoder import TextCrossEncoder; TextCrossEncoder('Xenova/ms-marco-MiniLM-L-6-v2')"

# 3. Project source last — only this layer rebuilds on code changes.
COPY src ./src
RUN uv sync --frozen --no-dev
COPY migrations ./migrations
COPY corpus ./corpus

ENV RAG_DATABASE_URL=postgresql://rag:rag@db:5432/rag
EXPOSE 8000

# Migrations + ingest on start is fine for this single-replica demo; multiple
# replicas would race here — move both to a one-shot job before scaling out.
CMD ["sh", "-c", "uv run rag ingest && uv run uvicorn rag.api.app:build_app --factory --host 0.0.0.0 --port 8000"]
